{
  "expo": {
    "name": "Carteirinha OCR",
    "slug": "carteirinha-ocr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carteirinhaocr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.caioapolonio.carteirinhaocr",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.caioapolonio.carteirinhaocr",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite ler sua carteirinha de estudante pela câmera."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "adc7bee3-c84e-48d7-be67-af4190b2a222"
      }
    }
  }
}
