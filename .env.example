# ──────────────────────────────────────────────
# Backend (apps/api) — usado a partir do M1
# ──────────────────────────────────────────────
API_PORT=3333
# Postgres provisionado pelo docker-compose.yml (host na 55432 p/ evitar conflitos comuns na 5432/5433)
DATABASE_URL=postgresql://ocr:ocr@localhost:55432/ocr
# Segredo que assina os JWTs (M5): obrigatório, mínimo de 16 caracteres.
# Gere um com: openssl rand -base64 32
JWT_SECRET=

# ──────────────────────────────────────────────
# Mobile (apps/mobile) — usado a partir do M2
# Variáveis EXPO_PUBLIC_* são embutidas no bundle. No celular, use o IP da
# máquina na rede local (ipconfig getifaddr en0), não localhost. Sem esta
# variável o app funciona 100% offline, sem sync.
# ──────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3333
